<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_beranda">

    <fragment
        android:id="@+id/navigation_beranda"
        android:name="com.project.topakuli.ui.beranda.BerandaFragment"
        android:label="@string/title_beranda"
        tools:layout="@layout/fragment_beranda">
        <action
            android:id="@+id/action_navigation_beranda_to_detailTanamanFragment"
            app:destination="@id/detailTanamanFragment" />
        <action
            android:id="@+id/action_navigation_beranda_to_detailResepFragment"
            app:destination="@id/detailResepFragment" />
        <action
            android:id="@+id/action_navigation_beranda_to_tipsAmanFragment"
            app:destination="@id/tipsAmanFragment" />
        <action
            android:id="@+id/action_navigation_beranda_to_historyFragment"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_navigation_beranda_to_historyDetailFragment"
            app:destination="@id/historyDetailFragment" />
        <action
            android:id="@+id/action_navigation_beranda_to_kontribusi"
            app:destination="@id/kontribusiFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.project.topakuli.ui.history.HistoryFragment"
        android:label="Riwayat Identifikasi"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_historyFragment_to_historyDetailFragment"
            app:destination="@id/historyDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyDetailFragment"
        android:name="com.project.topakuli.ui.history.HistoryDetailFragment"
        android:label="Hasil Identifikasi"
        tools:layout="@layout/fragment_history_detail">
        <argument
            android:name="nama"
            app:argType="string" />
        <argument
            android:name="namaLatin"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="namaDaerah"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="akurasi"
            app:argType="float" />
        <argument
            android:name="imagePath"
            app:argType="string" />
        <argument
            android:name="timestamp"
            app:argType="long"
            android:defaultValue="0L" />
        <argument
            android:name="tanamanId"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_herbal"
        android:name="com.project.topakuli.ui.herbal.HerbalFragment"
        android:label="@string/title_herbal"
        tools:layout="@layout/fragment_herbal">
        <action
            android:id="@+id/action_navigation_herbal_to_detailTanamanFragment"
            app:destination="@id/detailTanamanFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailTanamanFragment"
        android:name="com.project.topakuli.ui.herbal.DetailTanamanFragment"
        android:label="Detail Tanaman Obat"
        tools:layout="@layout/fragment_detail_tanaman">
        <argument
            android:name="tanamanId"
            app:argType="string" />
        <action
            android:id="@+id/action_detailTanamanFragment_to_detailResepFragment"
            app:destination="@id/detailResepFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_identifikasi"
        android:name="com.project.topakuli.ui.identifikasi.IdentifikasiFragment"
        android:label="@string/title_identifikasi"
        tools:layout="@layout/fragment_identifikasi">

        <action
            android:id="@+id/action_identifikasi_to_petunjuk"
            app:destination="@id/petunjukFragment" />
    </fragment>

    <fragment
        android:id="@+id/petunjukFragment"
        android:name="com.project.topakuli.ui.identifikasi.PetunjukFragment"
        android:label="Petunjuk Pengambilan Gambar"
        tools:layout="@layout/fragment_petunjuk" />

    <fragment
        android:id="@+id/navigation_resep"
        android:name="com.project.topakuli.ui.resep.ResepFragment"
        android:label="@string/title_resep"
        tools:layout="@layout/fragment_resep">
        <argument
            android:name="showHistory"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_navigation_resep_to_detailResepFragment"
            app:destination="@id/detailResepFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailResepFragment"
        android:name="com.project.topakuli.ui.resep.DetailResepFragment"
        android:label="Detail Resep Obat"
        tools:layout="@layout/fragment_detail_resep">
        <argument
            android:name="resepId"
            app:argType="string" />
        <action
            android:id="@+id/action_detailResepFragment_to_detailTanamanFragment"
            app:destination="@id/detailTanamanFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_setelan"
        android:name="com.project.topakuli.ui.Setelan.SetelanFragment"
        android:label="@string/title_setelan"
        tools:layout="@layout/fragment_setelan">
        <action
            android:id="@+id/action_setelan_to_tipsAman"
            app:destination="@id/tipsAmanFragment" />
        <action
            android:id="@+id/action_setelan_to_tentang"
            app:destination="@id/tentangFragment" />
        <action
            android:id="@+id/action_setelan_to_kontribusi"
            app:destination="@id/kontribusiFragment" />
    </fragment>

    <fragment
        android:id="@+id/kontribusiFragment"
        android:name="com.project.topakuli.ui.kontribusi.KontribusiFragment"
        android:label="Kontribusi &amp; Tanya"
        tools:layout="@layout/fragment_kontribusi" />

    <fragment
        android:id="@+id/tipsAmanFragment"
        android:name="com.project.topakuli.ui.Setelan.TipsAmanFragment"
        android:label="Tips Herbal Aman"
        tools:layout="@layout/fragment_tips_aman" />

    <fragment
        android:id="@+id/tentangFragment"
        android:name="com.project.topakuli.ui.Setelan.TentangFragment"
        android:label="@string/tentang_title"
        tools:layout="@layout/fragment_tentang" />

</navigation>