<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_admin_main"
    app:startDestination="@id/admin_navigation_beranda">

    <fragment
        android:id="@+id/admin_navigation_beranda"
        android:name="com.project.topakuli.ui.admin.beranda.AdminBerandaFragment"
        android:label="Beranda"
        tools:layout="@layout/fragment_admin_beranda">
        <action
            android:id="@+id/action_admin_navigation_beranda_to_adminActivityListFragment"
            app:destination="@id/adminActivityListFragment" />
        <action
            android:id="@+id/action_admin_navigation_beranda_to_adminLaporanFragment"
            app:destination="@id/adminLaporanFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminLaporanFragment"
        android:name="com.project.topakuli.ui.admin.beranda.AdminLaporanFragment"
        android:label="Laporan Tahunan"
        tools:layout="@layout/fragment_admin_laporan" />

    <fragment
        android:id="@+id/adminActivityListFragment"
        android:name="com.project.topakuli.ui.admin.beranda.AdminActivityListFragment"
        android:label="Daftar Aktivitas"
        tools:layout="@layout/fragment_admin_activity_list" />

    <fragment
        android:id="@+id/admin_navigation_herbal"
        android:name="com.project.topakuli.ui.admin.herbal.AdminHerbalFragment"
        android:label="Herbal"
        tools:layout="@layout/fragment_admin_herbal" />

    <fragment
        android:id="@+id/admin_navigation_resep"
        android:name="com.project.topakuli.ui.admin.resep.AdminResepFragment"
        android:label="Resep"
        tools:layout="@layout/fragment_admin_resep" />

    <fragment
        android:id="@+id/admin_navigation_survei"
        android:name="com.project.topakuli.ui.admin.common.AdminMasukanListFragment"
        android:label="Masukan"
        tools:layout="@layout/fragment_admin_masukan_list">
        <action
            android:id="@+id/action_adminMasukanListFragment_to_adminContributionDetailFragment"
            app:destination="@id/adminContributionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminContributionDetailFragment"
        android:name="com.project.topakuli.ui.admin.common.AdminContributionDetailFragment"
        android:label="Detail Ajuan"
        tools:layout="@layout/fragment_admin_contribution_detail">
        <argument
            android:name="CONTRIBUTION_ID"
            app:argType="string" />
        <argument
            android:name="CONTRIBUTION_TYPE"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/admin_navigation_setelan"
        android:name="com.project.topakuli.ui.admin.setelan.AdminSetelanFragment"
        android:label="Setelan"
        tools:layout="@layout/fragment_admin_setelan">
        <action
            android:id="@+id/action_admin_setelan_to_tentang"
            app:destination="@id/admin_navigation_tentang" />
        <action
            android:id="@+id/action_admin_setelan_to_manager_list"
            app:destination="@id/admin_manager_list" />
        <action
            android:id="@+id/action_admin_setelan_to_laporan"
            app:destination="@id/adminLaporanFragment" />
    </fragment>

    <fragment
        android:id="@+id/admin_manager_list"
        android:name="com.project.topakuli.ui.admin.setelan.AdminManagerListFragment"
        android:label="Daftar Pengelola"
        tools:layout="@layout/fragment_admin_manager_list">
        <action
            android:id="@+id/action_admin_manager_list_to_detail"
            app:destination="@id/admin_manager_detail" />
    </fragment>

    <fragment
        android:id="@+id/admin_manager_detail"
        android:name="com.project.topakuli.ui.admin.setelan.AdminManagerDetailFragment"
        android:label="Detail Pengelola"
        tools:layout="@layout/fragment_admin_manager_detail">
        <argument
            android:name="manager_uid"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/admin_navigation_tentang"
        android:name="com.project.topakuli.ui.Setelan.TentangFragment"
        android:label="Tentang Aplikasi"
        tools:layout="@layout/fragment_tentang" />

    <fragment
        android:id="@+id/admin_navigation_help"
        android:name="com.project.topakuli.ui.admin.help.AdminHelpFragment"
        android:label="Bantuan"
        tools:layout="@layout/fragment_admin_help" />

    <!-- Detail & Add Tanaman -->
    <fragment
        android:id="@+id/admin_detail_tanaman"
        android:name="com.project.topakuli.ui.admin.herbal.AdminDetailTanamanFragment"
        android:label="Detail Tanaman"
        tools:layout="@layout/fragment_admin_detail_tanaman" />

    <fragment
        android:id="@+id/admin_add_tanaman"
        android:name="com.project.topakuli.ui.admin.herbal.AdminAddTanamanFragment"
        android:label="Tambah Tanaman"
        tools:layout="@layout/fragment_admin_add_tanaman" />

    <!-- Detail & Add Resep -->
    <fragment
        android:id="@+id/admin_detail_resep"
        android:name="com.project.topakuli.ui.admin.resep.AdminDetailResepFragment"
        android:label="Detail Resep"
        tools:layout="@layout/fragment_admin_detail_resep" />

    <fragment
        android:id="@+id/admin_add_resep"
        android:name="com.project.topakuli.ui.admin.resep.AdminAddResepFragment"
        android:label="Tambah Resep"
        tools:layout="@layout/fragment_admin_add_resep" />

</navigation>
