<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/top_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/hijau_topakuli"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_intro_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="64dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:id="@+id/bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bg" />

    <ImageView
        android:id="@+id/iv_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/bg_intro_divider"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bg"
        app:layout_constraintTop_toTopOf="@+id/bottom_bg" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/nanami_book"
        android:gravity="center"
        android:textColor="#111827"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@+id/iv_divider"
        tools:text="Kenali Tanaman Obat di Desa Pakuli" />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:textColor="#4B5563"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        tools:text="Jelajahi 40+ spesies tanaman obat Desa Pakuli lengkap dengan manfaat, kandungan, dan cara penggunaannya secara aman." />

</androidx.constraintlayout.widget.ConstraintLayout>